{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://databolsa.dev/schemas/spec.schema.json",
  "title": "DataBolsa Feature Spec",
  "description": "Especificação executável de uma unidade de trabalho (feature, bugfix, refactor, infra). Uma spec por task, sob docs/specs/. É a fonte da verdade do que será construído antes de escrever código (Spec-Driven Development).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "id",
    "title",
    "status",
    "type",
    "created",
    "updated",
    "summary",
    "scope",
    "requirements",
    "acceptance_criteria",
    "test_plan"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Caminho relativo para este schema, p.ex. ./spec.schema.json"
    },
    "id": {
      "type": "string",
      "pattern": "^SPEC-[0-9]{4}$",
      "description": "Identificador sequencial da spec. Casa com o prefixo do nome do arquivo (NNNN-...)."
    },
    "title": {
      "type": "string",
      "minLength": 5,
      "description": "Título curto e descritivo da unidade de trabalho."
    },
    "status": {
      "type": "string",
      "enum": ["draft", "approved", "in_progress", "implemented", "verified", "superseded"],
      "description": "Ciclo de vida: draft → approved → in_progress → implemented → verified. 'superseded' quando substituída por outra spec."
    },
    "type": {
      "type": "string",
      "enum": ["feature", "bugfix", "refactor", "infra", "chore", "docs"],
      "description": "Natureza da mudança."
    },
    "created": {
      "type": "string",
      "format": "date",
      "description": "Data de criação (AAAA-MM-DD)."
    },
    "updated": {
      "type": "string",
      "format": "date",
      "description": "Data da última alteração desta spec (AAAA-MM-DD)."
    },
    "authors": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Responsáveis pela spec (humanos e/ou agentes)."
    },
    "supersedes": {
      "type": "string",
      "pattern": "^SPEC-[0-9]{4}$",
      "description": "ID da spec que esta substitui, se houver."
    },
    "summary": {
      "type": "string",
      "minLength": 10,
      "description": "O quê e por quê, em 1-3 frases. Deve ser legível por quem não conhece o código."
    },
    "motivation": {
      "type": "string",
      "description": "Problema/oportunidade que justifica o trabalho. Contexto e forças em jogo."
    },
    "related": {
      "type": "object",
      "additionalProperties": false,
      "description": "Rastreabilidade para a documentação de produto/arquitetura.",
      "properties": {
        "prd": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Seções do PRD relevantes, p.ex. 'PRD §7'."
        },
        "spec_doc": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Seções do SPEC.md relevantes, p.ex. 'SPEC §7'."
        },
        "business_rules": {
          "type": "array",
          "items": { "type": "string", "pattern": "^RN-[0-9]{2}$" },
          "description": "Regras de negócio cobertas, p.ex. 'RN-01'."
        },
        "adrs": {
          "type": "array",
          "items": { "type": "string" },
          "description": "ADRs relacionados, p.ex. 'ADR-0001'."
        },
        "depends_on": {
          "type": "array",
          "items": { "type": "string", "pattern": "^SPEC-[0-9]{4}$" },
          "description": "Specs que precisam estar prontas antes desta."
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["in_scope", "out_of_scope"],
      "properties": {
        "in_scope": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "O que será entregue."
        },
        "out_of_scope": {
          "type": "array",
          "items": { "type": "string" },
          "description": "O que explicitamente NÃO será feito aqui (proteção contra scope creep)."
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "description": "Requisitos funcionais/não-funcionais desta spec, rastreáveis e testáveis.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^REQ-[0-9]{2}$",
            "description": "Identificador local da spec, p.ex. 'REQ-01'."
          },
          "description": { "type": "string" },
          "rule_ref": {
            "type": "string",
            "pattern": "^RN-[0-9]{2}$",
            "description": "Regra de negócio do PRD que este requisito implementa, se aplicável."
          },
          "priority": {
            "type": "string",
            "enum": ["must", "should", "could"],
            "description": "MoSCoW."
          }
        }
      }
    },
    "data_model": {
      "type": "array",
      "description": "Mudanças no modelo de dados (novas entidades, campos, migrations).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entity", "change"],
        "properties": {
          "entity": { "type": "string", "description": "Ex.: 'Transaction'." },
          "change": {
            "type": "string",
            "enum": ["create", "alter", "drop", "none"]
          },
          "fields": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Campos afetados, com tipo. Lembre: dinheiro/quantidade em decimal/numeric, nunca float."
          },
          "notes": { "type": "string" }
        }
      }
    },
    "api": {
      "type": "array",
      "description": "Endpoints criados ou alterados.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["method", "path"],
        "properties": {
          "method": {
            "type": "string",
            "enum": ["GET", "POST", "PATCH", "PUT", "DELETE"]
          },
          "path": { "type": "string", "description": "Ex.: '/assets/:id/transactions'." },
          "auth": {
            "type": "boolean",
            "description": "Requer JWT? Toda rota fora de /auth/* exige (RN-11)."
          },
          "request": { "type": "string", "description": "Forma do corpo/params." },
          "response": { "type": "string", "description": "Forma da resposta." },
          "errors": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Erros esperados, p.ex. '422 venda maior que posição (RN-02)'."
          }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "description": "Critérios de aceite verificáveis, preferencialmente em Given/When/Then.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "given", "when", "then"],
        "properties": {
          "id": { "type": "string", "pattern": "^AC-[0-9]{2}$" },
          "given": { "type": "string" },
          "when": { "type": "string" },
          "then": { "type": "string" }
        }
      }
    },
    "test_plan": {
      "type": "array",
      "minItems": 1,
      "description": "Casos de teste, incluindo edge cases obrigatórios do domínio (venda parcial, venda total, ativo sem cotação, múltiplas compras, ativo em moeda estrangeira, posição zero).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "kind"],
        "properties": {
          "id": { "type": "string", "pattern": "^TC-[0-9]{2}$" },
          "description": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": ["unit", "integration", "e2e", "edge_case"]
          },
          "covers": {
            "type": "array",
            "items": { "type": "string" },
            "description": "IDs de requirements/AC cobertos, p.ex. ['REQ-01','AC-02']."
          },
          "mocks_external": {
            "type": "boolean",
            "description": "APIs externas devem ser mockadas — nunca rede em testes automatizados."
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "description": "Quebra da implementação em passos executáveis.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "done"],
        "properties": {
          "id": { "type": "string", "pattern": "^T-[0-9]{2}$" },
          "description": { "type": "string" },
          "target": { "type": "string", "description": "Pacote/app afetado, p.ex. 'packages/core'." },
          "done": { "type": "boolean" },
          "notes": { "type": "string", "description": "Notas específicas sobre esta tarefa." }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Riscos técnicos/de produto e mitigações."
    },
    "observability": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Logs, métricas ou alertas a adicionar (ex.: marcar cotação 'stale' — RN-10)."
    },
    "rollback": {
      "type": "string",
      "description": "Como reverter com segurança se necessário."
    },
    "layout": {
      "type": "object",
      "description": "Descreve a estrutura visual de cada seção e seus componentes."
    },
    "components": {
      "type": "object",
      "description": "Lista de novos componentes a criar e componentes reutilizados."
    },
    "notes": {
      "type": "string",
      "description": "Notas adicionais de implementação."
    }
  }
}
