        "content": "#0B1220"
      }
    },
    "semantic": {
      "light": {
        "background": "#F8FAFC",
        "surface": "#FFFFFF",
        "surfaceMuted": "#F1F5F9",
        "border": "#E2E8F0",
        "text": "#0F172A",
        "textMuted": "#475569",
