{
  "name": "databolsa",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "pnpm --filter @databolsa/core run build && pnpm --filter web run build",
    "test:web": "pnpm --filter web run test",
    "validate-specs": "ajv validate -s docs/specs/spec.schema.json -d 'docs/specs/finalizadas/*.json' --spec=draft2020 -c ajv-formats"
  },
  "devDependencies": {
    "ajv-cli": "^5.0.0",
    "ajv-formats": "^3.0.1"
  }
}
