// This is your Prisma schema file
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AssetClass {
  STOCK_BR
  FII
  ETF
  BDR
  CRYPTO
  STOCK_US
}

enum Currency {
  BRL
  USD
}

enum DataSource {
  BRAPI
  COINGECKO
  FINNHUB
}

enum TransactionType {
  BUY
  SELL
  DIVIDEND
}

enum Role {
  USER
  ADMIN
}

enum GroupMemberRole {
  LEADER
  MEMBER
}

model User {
  id                   String            @id @default(uuid())
  email                String            @unique
  password_hash        String
  refresh_token_hash   String?
  monthly_income_goal  Decimal?          @db.Decimal(18, 2)
  role                 Role              @default(USER)
  created_at           DateTime          @default(now()) @map("created_at")
  assets               Asset[]
  price_alerts         PriceAlert[]
  memberships          GroupMembership[]
  created_groups       Group[]           @relation("GroupCreator")
  created_invites      GroupInvite[]     @relation("InviteCreator")
  watches              AssetWatch[]
  analysis_alerts      AnalysisAlertRule[]

  @@map("users")
}

model Group {
  id          String            @id @default(uuid())
  name        String
  description String?
  created_by  String
  created_at  DateTime          @default(now())
  creator     User              @relation("GroupCreator", fields: [created_by], references: [id])
  memberships GroupMembership[]
  invites     GroupInvite[]

  @@map("groups")
}

model GroupMembership {
  id        String          @id @default(uuid())
  group_id  String
  user_id   String
  role      GroupMemberRole @default(MEMBER)
  joined_at DateTime        @default(now())
  group     Group           @relation(fields: [group_id], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([group_id, user_id])
  @@index([user_id])
  @@map("group_memberships")
}

model GroupInvite {
  id         String          @id @default(uuid())
  group_id   String
  code       String          @unique
  role       GroupMemberRole @default(MEMBER)
  created_by String
  expires_at DateTime?
  max_uses   Int?
  uses       Int             @default(0)
  revoked    Boolean         @default(false)
  created_at DateTime        @default(now())
  group      Group           @relation(fields: [group_id], references: [id], onDelete: Cascade)
  creator    User            @relation("InviteCreator", fields: [created_by], references: [id])

  @@map("group_invites")
}

model Asset {
  id           String        @id @default(uuid())
  user_id      String
  ticker       String
  name         String
  asset_class  AssetClass
  currency     Currency      @default(BRL)
  data_source  DataSource
  sector       String?
  created_at   DateTime      @default(now()) @map("created_at")
  user         User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([user_id, ticker])
  @@map("assets")
}

model Transaction {
  id         String          @id @default(uuid())
  asset_id   String
  type       TransactionType
  date       DateTime        @db.Date
  unit_price Decimal         @db.Decimal(18, 8)
  quantity   Decimal         @db.Decimal(18, 8)
  fees       Decimal         @default(0) @db.Decimal(18, 8)
  created_at DateTime        @default(now()) @map("created_at")
  asset      Asset           @relation(fields: [asset_id], references: [id], onDelete: Cascade)

  @@map("transactions")
}

model AssetWatch {
  id             String     @id @default(uuid())
  user_id        String
  ticker         String
  name           String?
  asset_class    AssetClass
  added_at       DateTime   @default(now()) @map("added_at")
  user           User       @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, ticker])
  @@map("asset_watch")
}

enum AlertCondition {
  ABOVE
  BELOW
}

model PriceAlert {
  id           String         @id @default(uuid())
  user_id      String
  asset_ticker String
  condition    AlertCondition
  target_price Decimal        @db.Decimal(18, 8)
  is_active    Boolean        @default(true)
  triggered_at DateTime?
  created_at   DateTime       @default(now()) @map("created_at")
  user         User           @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("price_alerts")
}

model AnalysisAlertRule {
  id           String         @id @default(uuid())
  user_id      String
  ticker       String
  metric       String
  condition    AlertCondition
  target_value Decimal        @db.Decimal(18, 4)
  is_active    Boolean        @default(true)
  triggered_at DateTime?
  created_at   DateTime       @default(now())
  user         User           @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("analysis_alert_rules")
}

model QuoteCache {
  id            String     @id @default(uuid())
  symbol        String
  source        DataSource
  price         Decimal    @db.Decimal(18, 8)
  currency      String
  changePercent Decimal?   @db.Decimal(18, 8)
  changeValue   Decimal?   @db.Decimal(18, 8)
  name          String?
  fetched_at    DateTime   @default(now()) @map("fetched_at")

  @@unique([symbol, source])
  @@map("quote_cache")
}

model BenchmarkSeriesCache {
  id         String   @id @default(uuid())
  series_key String
  period     String
  data       Json
  fetched_at DateTime @default(now()) @map("fetched_at")

  @@unique([series_key, period])
  @@map("benchmark_series_cache")
}

model AssetFundamentalsCache {
  id         String     @id @default(uuid())
  symbol     String
  source     DataSource
  data       Json
  fetched_at DateTime   @default(now()) @map("fetched_at")

  @@unique([symbol, source])
  @@map("asset_fundamentals_cache")
}

model CorporateEventCache {
  id          String     @id @default(uuid())
  symbol      String
  source      DataSource
  event_type  String
  event_date  DateTime   @db.Date
  description String?
  data        Json?
  fetched_at  DateTime   @default(now())

  @@unique([symbol, event_type, event_date])
  @@index([event_date])
  @@index([symbol, event_date])
  @@map("corporate_event_cache")
}
